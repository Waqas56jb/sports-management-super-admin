# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=5000
# Time zone used to decide what "today" means (upcoming vs completed fixtures, sessions).
APP_TIMEZONE=Africa/Djibouti

# ---------------------------------------------------------------- Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only secret (Supabase dashboard → Project Settings → API keys → secret / service_role).
# Required for Storage uploads. Never expose it to the frontends.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase PostgreSQL connection string (Dashboard → Connect → "Transaction pooler", port 6543).
# URL-encode special characters in the password (e.g. ! → %21).
DATABASE_URL=
# Optional: PEM of the Supabase CA certificate to verify the TLS connection.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------- auth
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Longer session when the user ticks "Keep me signed in".
JWT_REMEMBER_EXPIRES_IN=30d
BCRYPT_ROUNDS=11

# ---------------------------------------------------------------- HTTP
# Comma-separated list of the frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5174,http://localhost:5175,http://localhost:5176
# Public URL of each frontend (used in password-reset links).
ADMIN_FRONTEND_URL=http://localhost:5174
COACH_FRONTEND_URL=http://localhost:5175
PLAYER_FRONTEND_URL=http://localhost:5176

# ---------------------------------------------------------------- storage
STORAGE_BUCKET=uploads
UPLOAD_MAX_MB=5

# ---------------------------------------------------------------- rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------- seed (development only)
# Password given to every seeded demo account unless overridden per role.
SEED_ADMIN_PASSWORD=Admin@123
SEED_COACH_PASSWORD=Coach@123
SEED_PLAYER_PASSWORD=Player@123
