{
  "name": "sports-management-api",
  "version": "1.0.0",
  "description": "SportHub federation sports management API — Node.js, Express, Supabase PostgreSQL and Storage.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:status": "node src/db/migrate.js --status",
    "seed": "node src/db/seeds/seed.js",
    "seed:reset": "node src/db/seeds/seed.js --reset",
    "db:setup": "npm run migrate && npm run seed",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "schema:build": "node src/db/buildSchema.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0"
  },
  "keywords": [
    "sports",
    "express",
    "supabase",
    "postgresql",
    "railway"
  ],
  "license": "UNLICENSED"
}
